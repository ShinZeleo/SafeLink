<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginBottom="@dimen/spacing_xl">

                <androidx.cardview.widget.CardView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    android:layout_marginEnd="@dimen/spacing_md">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_logo_safelink"
                        android:scaleType="centerCrop" />
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/ink"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stay safe online!"
                        android:textColor="@color/charcoal"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_info"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_info"
                    android:background="@drawable/bg_circle_glass"
                    app:tint="@color/ink"
                    android:contentDescription="@string/desc_info" />
            </LinearLayout>

            <!-- Main Scan Input Area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="28dp"
                android:layout_marginBottom="@dimen/spacing_xl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Periksa Link Baru"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        app:errorEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_url"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/input_height"
                            android:background="@drawable/bg_input"
                            android:hint="@string/hint_enter_url"
                            android:textColorHint="@color/mute"
                            android:textColor="@color/ink"
                            android:paddingStart="24dp"
                            android:paddingEnd="100dp"
                            android:inputType="textUri"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Paste & Clean Buttons -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignTop="@id/til_url"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="16dp"
                        android:orientation="horizontal"
                        android:gravity="center">
                        
                        <!-- Scan QR Button -->
                        <ImageButton
                            android:id="@+id/btn_scan_qr"
                            android:layout_width="36dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_scan"
                            android:background="@drawable/bg_circle_glass"
                            app:tint="@color/ink"
                            android:padding="9dp"
                            android:scaleType="fitCenter"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="Scan QR" />
                        
                        <!-- Clean Button -->
                        <ImageButton
                            android:id="@+id/btn_clean_url"
                            android:layout_width="36dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_close"
                            android:background="@drawable/bg_circle_glass"
                            app:tint="@color/ink"
                            android:padding="9dp"
                            android:scaleType="fitCenter"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="@string/btn_clear" />
                        
                        <!-- Paste Button -->
                        <ImageButton
                            android:id="@+id/btn_paste"
                            android:layout_width="36dp"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_paste"
                            android:background="@drawable/bg_paste_button"
                            app:tint="@color/primary"
                            android:padding="9dp"
                            android:scaleType="fitCenter"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="@string/btn_paste" />
                    </LinearLayout>
                </RelativeLayout>

                <Button
                    android:id="@+id/btn_scan"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:text="@string/btn_scan"
                    android:textColor="@color/primary_on"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:letterSpacing="0.05"
                    android:background="@drawable/bg_button_primary"
                    app:backgroundTint="@null" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottie_loading"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="16dp"
                    android:layout_gravity="center"
                    app:lottie_rawRes="@raw/loading"
                    app:lottie_autoPlay="false"
                    app:lottie_loop="true"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Stats Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:id="@+id/tv_total_scans"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/ink"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total"
                        android:textColor="@color/charcoal"
                        android:textSize="10sp"
                        android:letterSpacing="0.1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginEnd="6dp"
                    android:layout_marginStart="2dp">

                    <TextView
                        android:id="@+id/tv_safe_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/accent_green"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aman"
                        android:textColor="@color/charcoal"
                        android:textSize="10sp"
                        android:letterSpacing="0.1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginStart="2dp">

                    <TextView
                        android:id="@+id/tv_danger_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/accent_red"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Berbahaya"
                        android:textColor="@color/charcoal"
                        android:textSize="10sp"
                        android:letterSpacing="0.1" />
                </LinearLayout>
            </LinearLayout>

            <!-- Daily Tip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="horizontal"
                android:padding="16dp"
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical">
                
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_nav_tips"
                    app:tint="@color/primary"
                    android:layout_marginEnd="12dp"/>
                    
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daily Security Tip"
                        android:textColor="@color/charcoal"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"/>
                        
                    <TextView
                        android:id="@+id/tv_daily_tip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tips loading..."
                        android:textColor="@color/ink"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Recent History Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today's Activity"
                        android:textColor="@color/ink"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                        
                    <TextView
                        android:id="@+id/tv_timeline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No activity today."
                        android:textColor="@color/charcoal"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_see_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lihat Semua"
                    android:textColor="@color/primary_light"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:padding="8dp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_recent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <LinearLayout
                android:id="@+id/tv_empty_recent"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_nav_history"
                    app:tint="@color/charcoal"
                    android:alpha="0.2"
                    android:layout_marginBottom="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_recent"
                    android:textColor="@color/charcoal" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>