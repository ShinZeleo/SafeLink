<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="0dp"
    android:paddingEnd="0dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:gravity="center_vertical">

    <!-- Status Dot -->
    <View
        android:id="@+id/view_status_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_status_safe"
        android:layout_marginEnd="12dp" />

    <!-- Engine Name & Result -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_engine_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kaspersky"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_engine_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="clean"
            android:textColor="@color/body"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Category Badge -->
    <TextView
        android:id="@+id/tv_engine_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HARMLESS"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/bg_status_safe" />

</LinearLayout>
